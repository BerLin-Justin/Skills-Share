digraph Architecture
{
    graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.44, splines=polyline, fontname="Microsoft YaHei", labelloc=t, fontsize=22];
    node [shape=box, style="rounded,filled", fillcolor="#EAF2FF", color="#3B6EA8", fontname="Microsoft YaHei", fontsize=17, margin="0.16,0.12", penwidth=1.3];
    edge [fontname="Microsoft YaHei", fontsize=13, color="#64748B", arrowsize=0.75];

    label="06  候选逻辑架构：模块分工，待工程核实";
    compound=true;
    subgraph cluster_ui
    {
        label="界面入口"; color="#B9CDE9"; style=rounded; fontsize=16;
        jsdui [label="JSD申请／详情"];
        payui [label="票据与付款办理"];
        queryui [label="合同台账／履约查询"];
        {rank=same; jsdui; payui; queryui;}
    }
    subgraph cluster_logic
    {
        label="候选业务职责 · 不代表独立服务"; color="#A6CEB7"; style="rounded,dashed"; fontsize=16;
        settlement [label="结算与审批\n占额／复核／防重出单", fillcolor="#E6F4EA", color="#38845B"];
        bills [label="票据与挂账\n分配／足额校验", fillcolor="#E6F4EA", color="#38845B"];
        funds [label="付款与核销\nFKSQ／真实FK", fillcolor="#E6F4EA", color="#38845B"];
        reads [label="同源查询\n只读汇总与追溯", fillcolor="#E6F4EA", color="#38845B"];
        {rank=same; settlement; bills; funds; reads;}
    }
    subgraph cluster_data
    {
        label="业务数据归属 · 存储与事务能力待核实"; color="#E5C592"; style="rounded,dashed"; fontsize=16;
        quota [label="结算数据\n计划／额度／JSD\n占用／快照／应付单", fillcolor="#FFF3DD", color="#B97716"];
        invoice [label="票据数据\n真实票／逐单分配", fillcolor="#FFF3DD", color="#B97716"];
        money [label="资金数据\nFKSQ／FK／核销关系", fillcolor="#FFF3DD", color="#B97716"];
        {rank=same; quota; invoice; money;}
    }
    boundary [label="事实接入边界（待核实）\n审批结果来源／真实出款凭证来源", fillcolor="#F1F5F9", color="#64748B", style="rounded,filled,dashed"];
    jsdui -> settlement [label="提交／详情"];
    payui -> bills [label="录票／分配"];
    payui -> funds [label="付款办理"];
    queryui -> reads [label="读取"];
    settlement -> quota [label="校验后读写"];
    bills -> invoice [label="校验后读写"];
    funds -> money [label="真实款及核销"];
    reads -> money [lhead=cluster_data, label="读取同源事实", style=dashed];
    boundary -> settlement [label="审批结果", style=dashed, constraint=false];
    boundary -> funds [label="付款事实", style=dashed, constraint=false];
    quota -> boundary [style=invis];
}

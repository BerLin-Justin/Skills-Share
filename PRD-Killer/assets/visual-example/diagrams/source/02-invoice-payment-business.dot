digraph Invoice
{
    graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.44, splines=polyline, fontname="Microsoft YaHei", labelloc=t, fontsize=22];
    node [shape=box, style="rounded,filled", fillcolor="#EAF2FF", color="#3B6EA8", fontname="Microsoft YaHei", fontsize=17, margin="0.16,0.12", penwidth=1.3];
    edge [fontname="Microsoft YaHei", fontsize=13, color="#64748B", arrowsize=0.75];

    label="02  实际票据：逐单足额才允许挂账";
    payable [label="JSD 已生成应付单\n状态：未开始", fillcolor="#FFF3DD", color="#B97716"];
    invoice [label="经办人登记真实票\n关联对应票据计划"];
    allocation [label="保存逐票逐单分配\n明确哪张票的多少钱归哪单"];
    enough [label="本单有效分配\n是否足额？", shape=diamond, fillcolor="#FFF3DD", color="#B97716"];
    lack [label="不足额：仍未开始\n显示缺口，继续补分配", fillcolor="#FDECEC", color="#B84A48"];
    post [label="足额后确认挂账\n票据与确认各自留痕", fillcolor="#E6F4EA", color="#38845B"];
    next [label="进入付款链\n见图02b"];
    { rank=same; payable; invoice; }
    { rank=same; allocation; enough; }
    { rank=same; lack; post; next; }
    payable -> allocation [label="限定具体目标单"];
    invoice -> allocation [label="分配含税票额"];
    allocation -> enough [label="按单汇总"];
    enough -> lack [label="否"];
    enough -> post [label="是"];
    lack -> allocation [label="补足再校验", constraint=false];
    post -> next;
}
